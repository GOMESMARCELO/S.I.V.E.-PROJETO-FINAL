# Modelo das configurações do S.I.V.E. Copie este arquivo para .env (na mesma pasta) e ajuste os valores.
# O .env NÃO vai para o Git: ele guarda a senha do banco e as chaves de segurança.

# Porta do site (http://localhost:PORTA)
PORTA=3000

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=sive
DB_PASSWORD=sive123
DB_NAME=db_sive
DB_CHARSET=utf8mb4

# Dados da escola (aparecem na Política de Privacidade)
ESCOLA_NOME="[Nome da escola]"
ESCOLA_ENCARREGADO_NOME="[Nome do encarregado de dados]"
ESCOLA_ENCARREGADO_EMAIL="[e-mail do encarregado]"
ESCOLA_PRAZO_RETENCAO="[prazo definido pela escola]"

# Segurança. EXIGIR_SENHA_FORTE=false e EXIGIR_2FA_GESTAO=false só para DEMONSTRAÇÃO (nunca com dados reais).
EXIGIR_SENHA_FORTE=true
EXIGIR_2FA_GESTAO=true
# true quando o sistema fica atrás de Nginx/servidor intermediário (usa o IP real de quem acessa)
ATRAS_DE_PROXY=false
TOKEN_HORAS=8

# Chaves de segurança: deixe em branco. O servidor cria sozinho na primeira vez e grava aqui.
# FAÇA BACKUP do .env: sem a CHAVE_ARQUIVOS, os documentos e os backups não abrem mais.
CHAVE_ARQUIVOS=
SEGREDO_TOKEN=
ASSINATURA_PRIVADA=
ASSINATURA_PUBLICA=

# Backups automáticos (um por dia). Recomendado: uma pasta fora do OneDrive, ex.: BACKUP_PASTA=D:\backups-sive
BACKUP_PASTA=backups
BACKUP_MANTER=14
# Logs de atividade mais antigos que isso são apagados
RETENCAO_LOGS_ANOS=2

# E-mail (recuperação de senha e códigos). EMAIL_MODO=simulado mostra as mensagens só no terminal; smtp envia de verdade.
EMAIL_MODO=simulado
EMAIL_URL_BASE=https://endereco-do-sistema.com.br
EMAIL_REMETENTE="S.I.V.E. <nao-responda@seudominio.com.br>"
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# HTTPS direto no Node (opcional): caminhos do certificado e da chave
HTTPS_CERTIFICADO=
HTTPS_CHAVE=
